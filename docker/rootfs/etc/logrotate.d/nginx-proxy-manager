/data/logs/*_access.log /data/logs/*/access.log {
    su npm npm
    create 0644
    weekly
    rotate 4
    missingok
    notifempty
    compress
    delaycompress
    sharedscripts
    postrotate
    kill -USR1 `cat /run/nginx/nginx.pid 2>/dev/null` 2>/dev/null || true
    endscript
}

/data/logs/*_error.log /data/logs/*/error.log {
    su npm npm
    create 0644
    weekly
    # A flapping upstream can produce hundreds of megabytes between weekly
    # rotations. Bound it by size as well so the collector never has to identify
    # an unbounded file.
    maxsize 50M
    rotate 10
    missingok
    notifempty
    compress
    sharedscripts
    postrotate
    kill -USR1 `cat /run/nginx/nginx.pid 2>/dev/null` 2>/dev/null || true
    endscript
}

# Security records may contain full query strings. Keep them separate from the
# broadly readable access logs and rotate by both age and size.
/data/logs/*_security.log {
    su npm npm
    create 0640 npm npm
    daily
    maxsize 50M
    rotate 30
    missingok
    notifempty
    compress
    delaycompress
    sharedscripts
    postrotate
    kill -USR1 `cat /run/nginx/nginx.pid 2>/dev/null` 2>/dev/null || true
    endscript
}
